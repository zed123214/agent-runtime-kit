# Agent Runtime Kit environment template
# Usage: cp .env.example .env, then edit local values.
# Never commit .env or real API keys.

# Core daemon
AGENTRT_HOST=127.0.0.1
AGENTRT_PORT=7437

# Logging
AGENTRT_LOG_LEVEL=INFO
# Leave empty to log to stderr only.
AGENTRT_LOG_FILE=~/.agentrt/logs/core.log
# text or json
AGENTRT_LOG_FORMAT=text

# Optional config file override
# AGENTRT_CONFIG=~/.agentrt/config.toml

# LLM provider
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# AGENTRT_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# AGENTRT_MAX_STEPS=20
# AGENTRT_ENGINE=loop

# Sandbox execution: Local remains the default (host filesystem, no isolation).
# AGENTRT_SANDBOX_BACKEND=local
# Kubernetes requires the optional kubernetes extra and an in-cluster Core.
# Full field/env mapping and deployment: docs/kubernetes-sandbox.md
# AGENTRT_SANDBOX_BACKEND=kubernetes
# AGENTRT_SANDBOX_DEPLOYMENT_SCOPE=agentrt-dev
# AGENTRT_SANDBOX_KUBERNETES_IMAGE=registry/worker@sha256:<real-64-hex-digest>
# AGENTRT_SANDBOX_KUBERNETES_OWNERSHIP_KEY_FILE=/run/agentrt/ownership/key
# Only set after independently validating the CNI, never to bypass startup:
# AGENTRT_SANDBOX_KUBERNETES_NETWORK_POLICY_VERIFIED=false

# Optional LangGraph engine (install with: uv sync --extra graph)
# Leave recursion limit unset to use: 2 * AGENTRT_MAX_STEPS + 1
# AGENTRT_GRAPH_RECURSION_LIMIT=41
# AGENTRT_GRAPH_TOOL_CALL_BUDGET=64
# AGENTRT_GRAPH_WALL_TIME_S=300
# AGENTRT_GRAPH_TRACE_EVENT_LIMIT=64

# Durable LangGraph recovery (install with: uv sync --extra graph-sqlite)
# The default checkpoint backend remains memory. SQLite paths are daemon-only
# configuration and must resolve inside AGENTRT_DATA_ROOT.
# AGENTRT_DATA_ROOT=~/.agentrt
# AGENTRT_GRAPH_CHECKPOINT_BACKEND=sqlite
# AGENTRT_GRAPH_CHECKPOINT_PATH=~/.agentrt/graph-checkpoints.sqlite3

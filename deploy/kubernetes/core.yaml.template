apiVersion: apps/v1
kind: Deployment
metadata:
  name: agentrt-core
  namespace: kitagent-core
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: agentrt-core
  template:
    metadata:
      labels:
        app.kubernetes.io/name: agentrt-core
        sandbox.agentrt.dev/scope: "${DEPLOYMENT_SCOPE}"
    spec:
      serviceAccountName: agentrt-core
      securityContext:
        runAsNonRoot: true
        runAsUser: 10000
        runAsGroup: 10000
        fsGroup: 10000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: core
          image: ${CORE_IMAGE}
          imagePullPolicy: IfNotPresent
          ports:
            - name: ipc
              containerPort: 7437
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
              ephemeral-storage: 128Mi
            limits:
              cpu: "2"
              memory: 1Gi
              ephemeral-storage: 2Gi
          env:
            - name: AGENTRT_HOST
              value: "0.0.0.0"
            - name: AGENTRT_DATA_ROOT
              value: /data
            - name: AGENTRT_SANDBOX_BACKEND
              value: kubernetes
            - name: AGENTRT_SANDBOX_DEPLOYMENT_SCOPE
              value: "${DEPLOYMENT_SCOPE}"
            - name: AGENTRT_SANDBOX_KUBERNETES_IMAGE
              value: ${WORKER_IMAGE}
            - name: AGENTRT_SANDBOX_KUBERNETES_OWNERSHIP_KEY_FILE
              value: /run/agentrt/ownership/key
            - name: AGENTRT_SANDBOX_KUBERNETES_NETWORK_POLICY_VERIFIED
              value: "${NETWORK_POLICY_VERIFIED}"
            - name: ANTHROPIC_API_KEY
              valueFrom:
                secretKeyRef:
                  name: agentrt-llm
                  key: ANTHROPIC_API_KEY
          volumeMounts:
            - name: data
              mountPath: /data
            - name: tmp
              mountPath: /tmp
            - name: ownership
              mountPath: /run/agentrt/ownership
              readOnly: true
          readinessProbe:
            tcpSocket:
              port: ipc
            periodSeconds: 2
      volumes:
        - name: data
          emptyDir:
            sizeLimit: 1Gi
        - name: tmp
          emptyDir:
            sizeLimit: 128Mi
        - name: ownership
          secret:
            secretName: agentrt-ownership
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: agentrt-core
  namespace: kitagent-core
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: agentrt-core
  ports:
    - name: ipc
      port: 7437
      targetPort: ipc
